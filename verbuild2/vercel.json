{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "build": {
    "env": {
      "CGO_ENABLED": "0"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.go": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
